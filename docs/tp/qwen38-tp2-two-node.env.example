# Qwen3.8 TP=2 two-node launcher configuration.
# Copy this file to qwen38-tp2-two-node.env and edit local paths before use.
# Values exported by the invoking shell take precedence over this file.

# Binary, model, and CUDA pack paths. Keep private machine paths in the local
# .env; these are deliberately portable placeholders.
RUNNER=./target/release/paddock-runner
MODEL=/path/to/Qwen3.8-27B-UD-Q4_K_M.gguf
PACK=./packs/cuda/build/pd-cuda-sm120.so
# The remote values default to RUNNER/MODEL/PACK when omitted.
# REMOTE_RUNNER=/path/to/paddock-runner
# REMOTE_MODEL=/path/to/Qwen3.8-27B-UD-Q4_K_M.gguf
# REMOTE_PACK=/path/to/pd-cuda-sm120.so

# Two-node addresses. Run this launcher on the head/rank-0 node.
WORKER_HOST=192.168.100.11
MASTER_ADDR=192.168.100.10
MASTER_PORT=11560

# Serving configuration.
HTTP_HOST=0.0.0.0
HTTP_PORT=11540
MAX_CTX=65536
MAX_BATCH=2

# KV cache and speculation. SPEC=on is the supported n-gram spelling;
# use SPEC=off for the public --no-spec path.
KV_DTYPE=f16
SPEC=on
TP_GRAPH=1

# NCCL/RoCE transport pins validated on the DGX Spark pair.
NCCL_SOCKET_IFNAME=enp1s0f0np0
NCCL_IB_HCA=rocep1s0f0
NCCL_IB_DISABLE=0
NCCL_NET=IB
# CUDA/NCCL loader aliases used by the validated hosts. Leave empty when the
# system loader already exposes libnccl.so.
LD_LIBRARY_PATH=/path/to/nccl:/path/to/cuda/lib64

# Optional SSH options, for example: SSH_OPTS="-o BatchMode=yes"
SSH_OPTS=
# Exact remote worker identity used for cleanup; do not reuse a live pidfile.
REMOTE_PIDFILE=/tmp/paddock-qwen38-tp2-worker-11560.pid
REMOTE_LOG=/tmp/paddock-qwen38-tp2-worker-11560.log
