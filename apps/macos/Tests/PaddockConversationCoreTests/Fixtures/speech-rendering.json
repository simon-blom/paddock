[
  {
    "name": "word clocks override sentence clocks",
    "meta": {"segments": [{"start": 1, "end": 3, "text": "Hej världen"}], "words": [{"word": "Hej", "start": 1.1, "end": 1.4, "confidence": 0.9}, {"word": "världen", "start": 1.7, "end": 2.2, "confidence": 0.3}]},
    "text": "Hej världen", "streaming": false,
    "expected": [{"word": "Hej", "start": 1.1, "end": 1.4, "confidence": 0.9, "segment": 0}, {"word": "världen", "start": 1.7, "end": 2.2, "confidence": 0.3, "segment": 0}]
  },
  {
    "name": "sentence timing never becomes word timing",
    "meta": {"segments": [{"start": 1, "end": 3, "text": "Hej världen"}]},
    "text": "Hej världen", "streaming": false,
    "expected": [{"word": "Hej", "start": 1, "segment": 0}, {"word": "världen", "start": 1, "segment": 0}]
  },
  {
    "name": "untimed confidence does not create a clock",
    "meta": {"words": [{"word": "Hej", "confidence": 0.45}, {"word": "världen", "confidence": 0.99}]},
    "text": "Hej världen", "streaming": false,
    "expected": [{"word": "Hej", "confidence": 0.45, "segment": -1}, {"word": "världen", "confidence": 0.99, "segment": -1}]
  },
  {
    "name": "live text is not masked by earlier completed words",
    "meta": {"words": [{"word": "Hej", "start": 0, "end": 0.5, "confidence": 0.3}]},
    "text": "Hej nästa mening 🦊", "streaming": true,
    "expected": [{"word": "Hej", "segment": -1}, {"word": "nästa", "segment": -1}, {"word": "mening", "segment": -1}, {"word": "🦊", "segment": -1}]
  },
  {
    "name": "segment confidence preserves only its sentence seek",
    "meta": {"segments": [{"start": 0.5, "end": 2, "text": "Hej där", "words": [{"word": "Hej", "confidence": 0.2, "start": 0.6, "end": 1}, {"word": "där", "confidence": 0.95}]}]},
    "text": "Hej där", "streaming": false,
    "expected": [{"word": "Hej", "confidence": 0.2, "start": 0.5, "segment": 0}, {"word": "där", "confidence": 0.95, "start": 0.5, "segment": 0}]
  },
  {
    "name": "plain unicode transcript remains native selectable text",
    "meta": {}, "text": "Hej\n世界 🦊", "streaming": false,
    "expected": [{"word": "Hej", "segment": -1}, {"word": "世界", "segment": -1}, {"word": "🦊", "segment": -1}]
  }
]
